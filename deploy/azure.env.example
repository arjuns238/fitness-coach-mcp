# Existing Azure resources to deploy into (deploy/azure.sh creates everything else). Copy to deploy/azure.env.
AZ_RG=
AZ_ENV=          # Container Apps environment with a Consumption workload profile
AZ_ACR=          # container registry name, without .azurecr.io
AZ_STORAGE=      # storage account for the Blob container
# Optional overrides
# APP=fitness-coach
# USER_TIMEZONE=America/Chicago
# COOLDOWN=900
